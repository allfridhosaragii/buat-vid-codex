{
  "name": "remotion-project",
  "version": "1.0.0",
  "description": "FlowGuard AI cinematic evidence-led product film",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.539",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "typecheck": "tsc --noEmit",
    "compositions": "remotion compositions src/index.ts --browser-executable=${REMOTION_BROWSER_EXECUTABLE:-/usr/bin/chromium}",
    "render:proof": "remotion render src/index.ts V2ProofSample out/V2ProofSample.mp4 --browser-executable=${REMOTION_BROWSER_EXECUTABLE:-/usr/bin/chromium} --codec=h264 --crf=22 --concurrency=2",
    "render:lookdev:s01": "remotion render src/index.ts V3S01Lookdev out/v3-lookdev/S01_Lookdev.mp4 --browser-executable=${REMOTION_BROWSER_EXECUTABLE:-/usr/bin/chromium} --codec=h264 --crf=20 --concurrency=2",
    "render:lookdev:s08": "remotion render src/index.ts V3S08Lookdev out/v3-lookdev/S08_Lookdev.mp4 --browser-executable=${REMOTION_BROWSER_EXECUTABLE:-/usr/bin/chromium} --codec=h264 --crf=20 --concurrency=2",
    "render:draft": "remotion render src/index.ts FlowGuardDemo out/FlowGuardDemo_V3_preview.mp4 --browser-executable=${REMOTION_BROWSER_EXECUTABLE:-/usr/bin/chromium} --codec=h264 --scale=0.5 --crf=27 --concurrency=2",
    "render:final": "remotion render src/index.ts FlowGuardDemo out/FlowGuardDemo_V3_3m30.mp4 --browser-executable=${REMOTION_BROWSER_EXECUTABLE:-/usr/bin/chromium} --codec=h264 --crf=18 --concurrency=2",
    "master:proof": "bash tools/master-audio.sh proof",
    "master:draft": "bash tools/master-audio.sh v3-preview",
    "master:final": "bash tools/master-audio.sh v3-final",
    "tts:setup": "cd .. && bash tools/tts/setup.sh",
    "tts:generate": "cd .. && .venv-tts/bin/python tools/tts/generate_narration.py && .venv-tts/bin/python tools/tts/generate_sound_design.py",
    "test:audio": "node tools/verify-narration.mjs",
    "test:timeline": "node tools/verify-timeline.mjs",
    "test": "npm run typecheck && npm run test:timeline && npm run test:audio",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  },
  "allowScripts": {
    "esbuild": false
  }
}
